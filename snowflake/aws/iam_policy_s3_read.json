{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeReadBronzeObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<S3_BUCKET>/bronze/*"
    },
    {
      "Sid": "SnowflakeListBronzePrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::<S3_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "bronze/*"
          ]
        }
      }
    }
  ]
}
